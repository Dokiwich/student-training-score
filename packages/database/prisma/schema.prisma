generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model appeals {
  id                               String         @id @db.VarChar(36)
  scoring_sheet_id                 String         @db.VarChar(36)
  reason                           String
  evidence_note                    String?
  status                           appeals_status @default(PENDING)
  resolved_by                      String?        @db.VarChar(36)
  resolution                       String?
  created_at                       DateTime       @default(now()) @db.Timestamp(0)
  resolved_at                      DateTime?      @db.Timestamp(0)
  dept_decision                    String?        @db.VarChar(20)
  dept_new_score                   Decimal?       @db.Decimal(5, 1)
  dept_resolution                  String?
  dept_resolved_at                 DateTime?      @db.Timestamp(0)
  dept_resolved_by                 String?        @db.VarChar(36)
  users_appeals_resolved_byTousers users?         @relation("appeals_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appeal_resolver")
  scoring_sheets                   scoring_sheets @relation(fields: [scoring_sheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appeal_sheet")

  @@index([resolved_by], map: "idx_appeal_resolver")
  @@index([scoring_sheet_id], map: "idx_appeal_sheet")
}

model audit_logs {
  id          String   @id @db.VarChar(36)
  actor_id    String   @db.VarChar(36)
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   String   @db.VarChar(36)
  old_value   Json?
  new_value   Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       users    @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_actor")

  @@index([actor_id], map: "idx_audit_actor")
  @@index([created_at], map: "idx_audit_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
}


model classes {
  id                   String                 @id @db.VarChar(36)
  code                 String                 @unique(map: "uk_class_code") @db.VarChar(20)
  name                 String                 @db.VarChar(100)
  department_id        String                 @db.VarChar(36)
  academic_year        String                 @db.VarChar(20)
  is_active            Int                    @default(1) @db.SmallInt
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  departments          departments            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_class_dept")
  semester_enrollments semester_enrollments[]

  @@index([department_id], map: "idx_class_dept")
}

model comments {
  id               String         @id @db.VarChar(36)
  scoring_sheet_id String         @db.VarChar(36)
  user_id          String         @db.VarChar(36)
  content          String
  parent_id        String?        @db.VarChar(36)
  created_at       DateTime       @default(now()) @db.Timestamp(0)
  comments         comments?      @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cmt_parent")
  other_comments   comments[]     @relation("commentsTocomments")
  scoring_sheets   scoring_sheets @relation(fields: [scoring_sheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cmt_sheet")

  @@index([parent_id], map: "idx_cmt_parent")
  @@index([scoring_sheet_id], map: "idx_cmt_sheet")
}

model criteria {
  id                  Int                 @id @default(autoincrement())
  category_id         String              @db.VarChar(36)
  parent_id           Int?
  code                String              @db.VarChar(20)
  content             String              @db.VarChar(500)
  point               Float               @default(0) @db.Real
  score               Float               @default(0) @map("min_score") @db.Real
  score_type          criteria_score_type @default(RANGE)
  score_options       Json?
  require_evidence    Int                 @default(0) @db.SmallInt
  evidence_guide      String?
  sort_order          Int                 @default(0)
  is_active           Int                 @default(1) @db.SmallInt
  created_at          DateTime            @default(now()) @db.Timestamp(0)
  updated_at          DateTime            @default(now()) @db.Timestamp(0)
  criteria_categories criteria_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_criteria_category")
  criteria            criteria?           @relation("criteriaTocriteria", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_criteria_parent")
  other_criteria      criteria[]          @relation("criteriaTocriteria")
  evidences           evidences[]
  score_details       score_details[]

  @@index([category_id], map: "idx_criteria_category")
  @@index([parent_id], map: "idx_criteria_parent")
}

model criteria_categories {
  id                  String            @id @db.VarChar(36)
  criteria_version_id String            @db.VarChar(36)
  code                String            @db.VarChar(10)
  name                String            @db.VarChar(200)
  description         String?
  max_score           Float             @db.Real
  sort_order          Int               @default(0)
  created_at          DateTime          @default(now()) @db.Timestamp(0)
  criteria            criteria[]
  criteria_versions   criteria_versions @relation(fields: [criteria_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cc_version")

  @@index([criteria_version_id], map: "idx_cc_version")
}

model criteria_versions {
  id                  String                @id @db.VarChar(36)
  semester_id         String                @db.VarChar(36)
  version             Int                   @default(1)
  is_active           Int                   @default(1) @db.SmallInt
  applied_at          DateTime              @db.Timestamp(0)
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  criteria_categories criteria_categories[]
  semesters           semesters             @relation(fields: [semester_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cv_semester")

  @@unique([semester_id, version], map: "uk_cv_semester_version")
}

model departments {
  id         String    @id @db.VarChar(36)
  code       String    @unique(map: "uk_dept_code") @db.VarChar(20)
  name       String    @db.VarChar(100)
  is_active  Int       @default(1) @db.SmallInt
  created_at DateTime  @default(now()) @db.Timestamp(0)
  classes    classes[]
  users      users[]
}

model evidences {
  id               String         @id @db.VarChar(36)
  scoring_sheet_id String         @db.VarChar(36)
  criteria_id      Int?
  file_name        String         @db.VarChar(255)
  file_url         String         @db.VarChar(500)
  file_type        String         @db.VarChar(50)
  file_size        Int
  description      String?
  uploaded_at      DateTime       @default(now()) @db.Timestamp(0)
  criteria         criteria?      @relation(fields: [criteria_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_ev_criteria")
  scoring_sheets   scoring_sheets @relation(fields: [scoring_sheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ev_sheet")

  @@index([criteria_id], map: "idx_ev_criteria")
  @@index([scoring_sheet_id], map: "idx_ev_sheet")
}

model notifications {
  id         String             @id @db.VarChar(36)
  user_id    String             @db.VarChar(36)
  type       notifications_type
  title      String             @db.VarChar(200)
  content    String
  data       Json?
  is_read    Int                @default(0) @db.SmallInt
  read_at    DateTime?          @db.Timestamp(0)
  created_at DateTime           @default(now()) @db.Timestamp(0)
  users      users              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notif_user")

  @@index([user_id, is_read], map: "idx_notif_user_read")
}

model refresh_tokens {
  id         String    @id @db.VarChar(36)
  token      String    @unique(map: "uk_rt_token") @db.VarChar(500)
  user_id    String    @db.VarChar(36)
  expires_at DateTime  @db.Timestamp(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  revoked_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rt_user")

  @@index([user_id], map: "idx_rt_user")
}

model review_actions {
  id               String                @id @db.VarChar(36)
  scoring_sheet_id String                @db.VarChar(36)
  reviewer_id      String                @db.VarChar(36)
  action           review_actions_action
  from_status      String                @db.VarChar(30)
  to_status        String                @db.VarChar(30)
  comment          String?
  metadata         Json?
  created_at       DateTime              @default(now()) @db.Timestamp(0)
  users            users                 @relation(fields: [reviewer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ra_reviewer")
  scoring_sheets   scoring_sheets        @relation(fields: [scoring_sheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ra_sheet")

  @@index([reviewer_id], map: "idx_ra_reviewer")
  @@index([scoring_sheet_id], map: "idx_ra_sheet")
}

model score_adjustment_logs {
  id              String        @id @db.VarChar(36)
  score_detail_id String        @db.VarChar(36)
  adjusted_by_id  String        @db.VarChar(36)
  old_score       Decimal       @db.Decimal(5, 1)
  new_score       Decimal       @db.Decimal(5, 1)
  reason          String?
  created_at      DateTime      @default(now()) @db.Timestamp(0)
  users           users         @relation(fields: [adjusted_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sal_adjuster")
  score_details   score_details @relation(fields: [score_detail_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sal_detail")

  @@index([adjusted_by_id], map: "idx_sal_adjuster")
  @@index([score_detail_id], map: "idx_sal_detail")
}

model score_details {
  id                    String                  @id @db.VarChar(36)
  scoring_sheet_id      String                  @db.VarChar(36)
  criteria_id           Int
  created_at            DateTime                @default(now()) @db.Timestamp(0)
  updated_at            DateTime                @default(now()) @db.Timestamp(0)
  note                  String?
  proof_url             String?
  score_adjustment_logs score_adjustment_logs[]
  criteria              criteria                @relation(fields: [criteria_id], references: [id])
  scoring_sheets        scoring_sheets          @relation(fields: [scoring_sheet_id], references: [id], onDelete: Cascade)
  score_entries         score_entries[]

  @@unique([scoring_sheet_id, criteria_id])
  @@index([criteria_id], map: "idx_sd_criteria")
}

model score_entries {
  id              String        @id @db.VarChar(36)
  score_detail_id String        @db.VarChar(36)
  scorer_role     scorer_role
  score           Decimal       @db.Decimal(5, 2)
  scored_at       DateTime      @default(now()) @db.Timestamp(0)
  score_details   score_details @relation(fields: [score_detail_id], references: [id], onDelete: Cascade, map: "fk_se_detail")

  @@unique([score_detail_id, scorer_role], map: "uk_se_detail_role")
  @@index([scorer_role], map: "idx_se_role")
}

model scoring_sheets {
  id                   String                         @id @db.VarChar(36)
  status               scoring_sheets_status          @default(DRAFT)
  current_step         Int                            @default(1) @db.SmallInt
  student_total        Decimal?                       @db.Decimal(5, 1)
  class_total          Decimal?                       @db.Decimal(5, 1)
  advisor_total        Decimal?                       @db.Decimal(5, 1)
  final_total          Decimal?                       @db.Decimal(5, 1)
  classification       scoring_sheets_classification?
  student_submitted_at DateTime?                      @db.Timestamp(0)
  class_reviewed_at    DateTime?                      @db.Timestamp(0)
  advisor_approved_at  DateTime?                      @db.Timestamp(0)
  school_finalized_at  DateTime?                      @db.Timestamp(0)
  rejection_reason     String?
  rejected_by_step     Int?                           @db.SmallInt
  created_at           DateTime                       @default(now()) @db.Timestamp(0)
  updated_at           DateTime                       @default(now()) @db.Timestamp(0)
  enrollment_id        String                         @unique(map: "uk_sheet_enrollment") @db.VarChar(36)
  appeals              appeals[]
  comments             comments[]
  evidences            evidences[]
  review_actions       review_actions[]
  score_details        score_details[]
  semester_enrollments semester_enrollments           @relation(fields: [enrollment_id], references: [id], map: "fk_sheet_enrollment")

  @@index([status], map: "idx_sheet_status")
  @@index([enrollment_id, status], map: "idx_sheet_enrollment_status")
}

model semesters {
  id                       String                 @id @db.VarChar(36)
  code                     String                 @unique(map: "uk_semester_code") @db.VarChar(20)
  name                     String                 @db.VarChar(100)
  academic_year            String                 @db.VarChar(20)
  semester_number          Int                    @db.SmallInt
  start_date               DateTime               @db.Timestamp(0)
  end_date                 DateTime               @db.Timestamp(0)
  student_deadline         DateTime               @db.Timestamp(0)
  class_committee_deadline DateTime               @db.Timestamp(0)
  advisor_deadline         DateTime               @db.Timestamp(0)
  school_deadline          DateTime               @db.Timestamp(0)
  status                   semesters_status       @default(UPCOMING)
  is_active                Int                    @default(1) @db.SmallInt
  created_at               DateTime               @default(now()) @db.Timestamp(0)
  criteria_versions        criteria_versions[]
  semester_enrollments     semester_enrollments[]
}

model semester_enrollments {
  id             String          @id @db.VarChar(36)
  user_id        String          @db.VarChar(36)
  semester_id    String          @db.VarChar(36)
  class_id       String          @db.VarChar(36)
  enrolled_at    DateTime        @default(now()) @db.Timestamp(0)
  is_active      Int             @default(1) @db.SmallInt
  scoring_sheets scoring_sheets?
  classes        classes         @relation(fields: [class_id], references: [id], onDelete: NoAction, map: "fk_sen_class")
  semesters      semesters       @relation(fields: [semester_id], references: [id], onDelete: NoAction, map: "fk_sen_semester")
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_sen_user")

  @@unique([user_id, semester_id], map: "uk_sen_user_semester")
  @@index([class_id, semester_id], map: "idx_sen_class_semester")
  @@index([semester_id], map: "idx_sen_semester")
}

model users {
  id                                 String                  @id @db.VarChar(36)
  student_id                         String?                 @unique(map: "uk_user_student_id") @db.VarChar(20)
  email                              String                  @unique(map: "uk_user_email") @db.VarChar(100)
  password_hash                      String                  @db.VarChar(255)
  full_name                          String                  @db.VarChar(100)
  avatar_url                         String?                 @db.VarChar(500)
  phone                              String?                 @db.VarChar(20)
  department_id                      String?                 @db.VarChar(36)
  is_active                          Int                     @default(1) @db.SmallInt
  last_login_at                      DateTime?               @db.Timestamp(0)
  created_at                         DateTime                @default(now()) @db.Timestamp(0)
  updated_at                         DateTime                @default(now()) @db.Timestamp(0)
  failed_login_attempts              Int                     @default(0) @db.SmallInt
  locked_until                       DateTime?               @db.Timestamp(0)
  session_version                    Int                     @default(1)
  appeals_appeals_resolved_byTousers appeals[]               @relation("appeals_resolved_byTousers")
  audit_logs                         audit_logs[]
  notifications                      notifications[]
  refresh_tokens                     refresh_tokens[]
  review_actions                     review_actions[]
  score_adjustment_logs              score_adjustment_logs[]
  semester_enrollments               semester_enrollments[]
  departments                        departments?            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_dept")
  user_roles                         user_roles[]

  @@index([department_id], map: "idx_user_dept")
}

enum notifications_type {
  SCORING_OPENED
  DEADLINE_REMINDER
  SCORE_SUBMITTED
  SCORE_REVIEWED
  SCORE_APPROVED
  SCORE_REJECTED
  SCORE_FINALIZED
  APPEAL_SUBMITTED
  APPEAL_RESOLVED
  SYSTEM_ANNOUNCEMENT
}

enum class_roles_role_type {
  MONITOR
  VICE_MONITOR
  SECRETARY
  ADVISOR
}

enum review_actions_action {
  SUBMIT
  APPROVE
  REJECT
  ADJUST_SCORE
  COMMENT
  RESUBMIT
  APPEAL
  FINALIZE
}

enum scoring_sheets_status {
  DRAFT
  STUDENT_SUBMITTED
  CLASS_REVIEWING
  CLASS_REVIEWED
  CLASS_REJECTED
  ADVISOR_REVIEWING
  ADVISOR_APPROVED
  ADVISOR_REJECTED
  SCHOOL_REVIEWING
  SCHOOL_APPROVED
  SCHOOL_REJECTED
  FINALIZED
  APPEALING

  @@map("scoring_sheets_status")
}

enum appeals_status {
  PENDING
  ACCEPTED
  REJECTED
  DEPT_REVIEWED
}

enum criteria_score_type {
  RANGE
  OPTIONS
  BOOLEAN
  DEDUCTION
}

enum scorer_role {
  STUDENT
  CLASS_COMMITTEE
  ADVISOR
}

enum scoring_sheets_classification {
  EXCELLENT
  VERY_GOOD
  GOOD
  AVERAGE
  WEAK
  POOR
}

enum semesters_status {
  UPCOMING
  STUDENT_SCORING
  CLASS_REVIEWING
  ADVISOR_REVIEWING
  SCHOOL_REVIEWING
  FINALIZED
  LOCKED
}

enum users_role {
  STUDENT
  CLASS_COMMITTEE
  ADVISOR
  DEPARTMENT
  SCHOOL_ADMIN
}

model roles {
  id          String       @id @db.VarChar(36)
  code        String       @unique @db.VarChar(50)
  name        String       @db.VarChar(100)
  scope       String       @db.VarChar(20)
  user_roles  user_roles[]
}

model user_roles {
  id         String    @id @db.VarChar(36)
  user_id    String    @db.VarChar(36)
  role_id    String    @db.VarChar(36)
  entity_id  String?   @db.VarChar(36)
  is_active  Int       @default(1) @db.SmallInt
  start_date DateTime  @default(now()) @db.Timestamp(0)
  end_date   DateTime? @db.Timestamp(0)
  
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, entity_id], map: "uk_user_role_entity")
  @@index([user_id], map: "idx_ur_user")
  @@index([entity_id], map: "idx_ur_entity")
}
