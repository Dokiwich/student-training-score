// =============================================
// Schema Prisma sau khi fix 3NF
// File tham khảo — Sau khi chạy migrate_3nf_fix.js,
// chạy `npx prisma db pull` để tự generate schema mới.
// =============================================
// 
// THAY ĐỔI SO VỚI schema.prisma:
//
// 1. appeals: XÓA cột student_id + FK + index
//    → Dùng JOIN scoring_sheets để lấy student_id
//
// 2. users: XÓA cột class_id + FK + index  
//    → Dùng semester_enrollments để lấy class_id theo kỳ
//
// 3. scoring_sheets: class_id giữ nguyên (snapshot tại thời điểm tạo phiếu)
//
// 4. semester_enrollments: Giữ nguyên (nguồn chính thức class_id theo kỳ)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ✅ 3NF: Xóa student_id (phụ thuộc bắc cầu qua scoring_sheets)
model appeals {
  id                               String         @id @db.VarChar(36)
  scoring_sheet_id                 String         @db.VarChar(36)
  reason                           String         @db.Text
  evidence_note                    String?        @db.Text
  status                           appeals_status @default(PENDING)
  resolved_by                      String?        @db.VarChar(36)
  resolution                       String?        @db.Text
  created_at                       DateTime       @default(now()) @db.DateTime(0)
  resolved_at                      DateTime?      @db.DateTime(0)
  users_appeals_resolved_byTousers users?         @relation("appeals_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appeal_resolver")
  scoring_sheets                   scoring_sheets @relation(fields: [scoring_sheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_appeal_sheet")

  @@index([resolved_by], map: "idx_appeal_resolver")
  @@index([scoring_sheet_id], map: "idx_appeal_sheet")
}

// ✅ 3NF: Xóa class_id (dùng semester_enrollments thay thế)
model users {
  id                                 String                  @id @db.VarChar(36)
  student_id                         String?                 @unique(map: "uk_user_student_id") @db.VarChar(20)
  email                              String                  @unique(map: "uk_user_email") @db.VarChar(100)
  password_hash                      String                  @db.VarChar(255)
  full_name                          String                  @db.VarChar(100)
  avatar_url                         String?                 @db.VarChar(500)
  phone                              String?                 @db.VarChar(20)
  role                               users_role              @default(STUDENT)
  department_id                      String?                 @db.VarChar(36)
  is_active                          Int                     @default(1) @db.TinyInt
  last_login_at                      DateTime?               @db.DateTime(0)
  created_at                         DateTime                @default(now()) @db.DateTime(0)
  updated_at                         DateTime                @default(now()) @db.DateTime(0)
  appeals_appeals_resolved_byTousers appeals[]               @relation("appeals_resolved_byTousers")
  audit_logs                         audit_logs[]
  class_roles                        class_roles[]
  notifications                      notifications[]
  refresh_tokens                     refresh_tokens[]
  review_actions                     review_actions[]
  score_adjustment_logs              score_adjustment_logs[]
  scoring_sheets                     scoring_sheets[]
  semester_enrollments               semester_enrollments[]
  departments                        departments?            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_dept")

  @@index([department_id], map: "idx_user_dept")
  @@index([role], map: "idx_user_role")
}
